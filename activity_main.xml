<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout android:id="@+id/swipe"
        android:layout_width="match_parent" android:layout_height="match_parent">
        <WebView android:id="@+id/webView"
            android:layout_width="match_parent" android:layout_height="match_parent" />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    <ProgressBar android:id="@+id/progress"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
        android:layout_width="match_parent" android:layout_height="3dp"
        android:visibility="gone" />
    <!-- Pegangan setengah lonjong di tepi kanan; diketuk = muncul 3 tombol bulat (QuickTools.kt) -->
    <ImageButton android:id="@+id/menuBtn"
        android:layout_width="52dp" android:layout_height="76dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="100dp"
        android:background="@drawable/bg_fab_handle" android:alpha="1"
        android:src="@drawable/ic_chevron_left"
        android:scaleType="center"
        android:contentDescription="Alat cepat" />
</FrameLayout>
