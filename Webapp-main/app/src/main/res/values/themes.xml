<resources>
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <!-- Semua AlertDialog (ketik alamat, ubah situs, konfirmasi, diagnosa) memakai gaya gelap ini -->
        <item name="alertDialogTheme">@style/AppDialog</item>
    </style>

    <style name="AppDialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="android:colorBackground">#FF1F2024</item>
        <item name="android:colorBackgroundFloating">#FF1F2024</item>
        <item name="colorBackgroundFloating">#FF1F2024</item>
        <item name="android:textColorPrimary">#FFFFFFFF</item>
        <item name="android:textColorSecondary">#FF9AA0AC</item>
        <item name="android:textColorHint">#FF6B6F7A</item>
        <item name="android:textColor">#FFE6E8EE</item>
        <item name="colorAccent">#FF7FA8FF</item>
        <item name="colorControlNormal">#FF6B6F7A</item>
        <item name="colorControlActivated">#FF7FA8FF</item>
        <item name="android:windowMinWidthMajor">80%</item>
        <item name="android:windowMinWidthMinor">88%</item>
    </style>
</resources>
